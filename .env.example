# Chaîne de connexion MongoDB (Atlas ou instance locale)
CONNECTION_STRING=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/resafacile

# Origine du frontend autorisée par CORS en production (localhost:3000/3001 sont déjà autorisés)
FRONTEND_URL=

# Clé API SIRENE (INSEE) — https://portail-api.insee.fr
SIRENE_API_KEY=

# Twilio (envoi des SMS de confirmation)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
